{
  "name": "@ciphore/radiocli",
  "version": "0.2.6",
  "description": "A terminal-first world radio receiver built with Ink, mpv, and resilient public-radio providers.",
  "type": "module",
  "license": "MIT",
  "author": "Ciphore",
  "homepage": "https://github.com/Ciphore/RadioCLI#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ciphore/RadioCLI.git"
  },
  "bugs": {
    "url": "https://github.com/Ciphore/RadioCLI/issues"
  },
  "keywords": [
    "terminal",
    "tui",
    "cli",
    "radio",
    "internet-radio",
    "mpv",
    "ink",
    "react",
    "radio-browser",
    "playlist"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md",
    "docs",
    "scripts/build-airplay-native.mjs",
    "vendor/node-airtunes2/lib",
    "vendor/node-airtunes2/src",
    "vendor/node-airtunes2/package.json",
    "vendor/node-airtunes2/binding.gyp",
    "vendor/node-airtunes2/LICENSE",
    "vendor/node-airtunes2/README.md",
    "vendor/node-airtunes2/RADIOCLI_PATCH.md",
    "vendor/node-airtunes2/UPSTREAM.json"
  ],
  "bin": {
    "radiocli": "dist/cli.js"
  },
  "scripts": {
    "dev": "tsx src/cli.tsx",
    "clean": "node -e \"require('node:fs').rmSync('dist', {recursive: true, force: true})\"",
    "build": "npm run clean && tsc -p tsconfig.build.json && node scripts/ensure-bin-executable.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "check:unused": "tsc -p tsconfig.json --noEmit --noUnusedLocals --noUnusedParameters",
    "check:whitespace": "node scripts/whitespace-check.mjs",
    "check:exports": "knip",
    "check:package": "publint",
    "audit:runtime": "node scripts/audit-ci.mjs --omit=dev --include=optional --audit-level=low",
    "audit:docs": "node scripts/audit-ci.mjs --prefix=apps/docs --omit=dev --audit-level=high",
    "lint": "npm run check:unused && npm run check:whitespace && npm run check:exports",
    "docs:dev": "npm --prefix apps/docs run dev",
    "docs:build": "npm --prefix apps/docs run build",
    "docs:check": "npm --prefix apps/docs run check",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "verify": "npm run check && npm run lint && npm run test && npm run build && npm run smoke:data",
    "verify:release": "node scripts/verify-release.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm run verify:release",
    "pack:check": "npm pack --dry-run",
    "smoke:data": "tsx src/smoke/data-smoke.ts",
    "smoke:mcp": "node scripts/mcp-smoke.mjs",
    "smoke:playback": "tsx src/smoke/playback-smoke.ts",
    "smoke:network": "tsx src/smoke/network-playback-smoke.ts",
    "smoke:cli": "tsx src/smoke/cli-smoke.ts",
    "demo:script": "node scripts/demo-script.mjs",
    "demo:assets": "node scripts/capture-demo-assets.mjs",
    "fresh:check": "node scripts/fresh-check.mjs",
    "postinstall": "node scripts/build-airplay-native.mjs"
  },
  "dependencies": {
    "@homebridge/dbus-native": "^0.7.9",
    "@modelcontextprotocol/server": "^2.3.1",
    "chalk": "^5.6.2",
    "ink": "^7.0.5",
    "jsonc-parser": "^3.3.1",
    "react": "^19.2.6",
    "string-width": "8.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.15",
    "ink-testing-library": "^4.0.0",
    "knip": "^6.14.2",
    "publint": "^0.3.21",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22"
  },
  "optionalDependencies": {
    "@noble/ed25519": "1.7.5",
    "async": "3.2.6",
    "axlsign": "git+https://github.com/ciderapp/curve25519-js.git#cae68782564b83ffa1c7c757e40a3944cb140290",
    "big-integer": "1.6.52",
    "bplist-creator": "0.1.1",
    "bplist-parser": "0.3.2",
    "chacha-js": "git+https://github.com/ciderapp/chacha20poly1305.git#f85941b8f5c62843a1459758cc3dbabad9f849cb",
    "curve25519-js": "0.0.4",
    "fast-srp-hap": "2.0.4",
    "js-sha1": "0.7.0",
    "lodash": "4.18.1",
    "python-struct": "1.1.3",
    "node-gyp": "12.3.0"
  }
}

{
  "name": "radiocli-docs",
  "version": "0.2.6",
  "private": true,
  "description": "Public website and documentation for RadioCLI.",
  "type": "module",
  "scripts": {
    "predev": "node ../../scripts/build-receiver-preview.mjs",
    "dev": "next dev",
    "prebuild": "node ../../scripts/build-receiver-preview.mjs",
    "build": "next build",
    "start": "next start",
    "precheck": "node ../../scripts/build-receiver-preview.mjs",
    "check": "next typegen && fumadocs-mdx && tsc --noEmit",
    "postinstall": "fumadocs-mdx"
  },
  "dependencies": {
    "fumadocs-core": "16.9.3",
    "fumadocs-mdx": "15.0.10",
    "fumadocs-ui": "16.9.3",
    "lucide-react": "^1.17.0",
    "next": "16.4.2",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@types/mdx": "^2.0.13",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "esbuild": "0.28.1",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "postcss": "$postcss"
  },
  "engines": {
    "node": ">=22"
  }
}
